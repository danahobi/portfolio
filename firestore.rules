rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnerAdmin() {
      return isSignedIn() &&
        (request.auth.token.email == 'danahobi20@gmail.com' ||
         exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidProject(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 150 &&
             data.category is string && data.category.size() <= 60 &&
             data.description is string && data.description.size() <= 500 &&
             data.thumbnail is string && data.thumbnail.size() <= 1000 &&
             data.liveDemoUrl is string && data.liveDemoUrl.size() <= 1000;
    }

    function isValidService(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 150 &&
             data.description is string && data.description.size() <= 500 &&
             data.iconName is string && data.iconName.size() <= 60;
    }

    function isValidPricingPlan(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 100 &&
             data.price is string && data.price.size() <= 50 &&
             data.subtitle is string && data.subtitle.size() <= 300;
    }

    function isValidTestimonial(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 100 &&
             data.quote is string && data.quote.size() <= 1000 &&
             data.rating is number && data.rating >= 1 && data.rating <= 5;
    }

    function isValidFaq(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.question is string && data.question.size() <= 250 &&
             data.answer is string && data.answer.size() <= 1500;
    }

    function isValidSiteProfile(data) {
      return data.brandName is string && data.brandName.size() <= 100 &&
             data.headline is string && data.headline.size() <= 250 &&
             data.email is string && data.email.size() <= 150;
    }

    function isValidAdmin(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.email is string && data.email.size() <= 150 &&
             data.role is string && data.role.size() <= 50;
    }

    // Projects Collection
    match /projects/{projectId} {
      allow read: if true;
      allow create: if isOwnerAdmin() && isValidId(projectId) && isValidProject(incoming());
      allow update: if isOwnerAdmin() && isValidId(projectId) && isValidProject(incoming());
      allow delete: if isOwnerAdmin() && isValidId(projectId);
    }

    // Services Collection
    match /services/{serviceId} {
      allow read: if true;
      allow create: if isOwnerAdmin() && isValidId(serviceId) && isValidService(incoming());
      allow update: if isOwnerAdmin() && isValidId(serviceId) && isValidService(incoming());
      allow delete: if isOwnerAdmin() && isValidId(serviceId);
    }

    // Pricing Plans Collection
    match /pricingPlans/{planId} {
      allow read: if true;
      allow create: if isOwnerAdmin() && isValidId(planId) && isValidPricingPlan(incoming());
      allow update: if isOwnerAdmin() && isValidId(planId) && isValidPricingPlan(incoming());
      allow delete: if isOwnerAdmin() && isValidId(planId);
    }

    // Testimonials Collection
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow create: if isOwnerAdmin() && isValidId(testimonialId) && isValidTestimonial(incoming());
      allow update: if isOwnerAdmin() && isValidId(testimonialId) && isValidTestimonial(incoming());
      allow delete: if isOwnerAdmin() && isValidId(testimonialId);
    }

    // FAQs Collection
    match /faqs/{faqId} {
      allow read: if true;
      allow create: if isOwnerAdmin() && isValidId(faqId) && isValidFaq(incoming());
      allow update: if isOwnerAdmin() && isValidId(faqId) && isValidFaq(incoming());
      allow delete: if isOwnerAdmin() && isValidId(faqId);
    }

    // Settings Collection
    match /settings/{settingId} {
      allow read: if true;
      allow create, update: if isOwnerAdmin() && isValidId(settingId) && isValidSiteProfile(incoming());
      allow delete: if isOwnerAdmin() && isValidId(settingId);
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read: if isOwnerAdmin();
      allow create, update: if isOwnerAdmin() && isValidId(adminId) && isValidAdmin(incoming());
      allow delete: if isOwnerAdmin() && isValidId(adminId);
    }
  }
}
