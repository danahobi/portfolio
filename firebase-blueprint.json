{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "Portfolio project case study item showcase",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 150 },
        "category": { "type": "string", "maxLength": 60 },
        "description": { "type": "string", "maxLength": 500 },
        "client": { "type": "string", "maxLength": 120 },
        "duration": { "type": "string", "maxLength": 60 },
        "thumbnail": { "type": "string", "maxLength": 1000 },
        "previewVideoUrl": { "type": "string", "maxLength": 1000 },
        "liveDemoUrl": { "type": "string", "maxLength": 1000 },
        "githubUrl": { "type": "string", "maxLength": 1000 },
        "problem": { "type": "string", "maxLength": 2000 },
        "solution": { "type": "string", "maxLength": 2000 },
        "tags": { "type": "array" },
        "features": { "type": "array" },
        "screenshots": { "type": "array" },
        "featured": { "type": "boolean" },
        "hidden": { "type": "boolean" },
        "order": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "category", "description", "thumbnail", "liveDemoUrl"]
    },
    "Service": {
      "title": "Service",
      "description": "Service offering card",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 150 },
        "description": { "type": "string", "maxLength": 500 },
        "iconName": { "type": "string", "maxLength": 60 },
        "highlights": { "type": "array" },
        "order": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "description", "iconName"]
    },
    "PricingPlan": {
      "title": "PricingPlan",
      "description": "Pricing tier package",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "price": { "type": "string", "maxLength": 50 },
        "subtitle": { "type": "string", "maxLength": 300 },
        "features": { "type": "array" },
        "isRecommended": { "type": "boolean" },
        "serviceCategory": { "type": "string", "maxLength": 100 },
        "turnaroundTime": { "type": "string", "maxLength": 60 },
        "order": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "price", "subtitle"]
    },
    "Testimonial": {
      "title": "Testimonial",
      "description": "Client review testimonial",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "maxLength": 100 },
        "businessType": { "type": "string", "maxLength": 100 },
        "rating": { "type": "number" },
        "quote": { "type": "string", "maxLength": 1000 },
        "avatar": { "type": "string", "maxLength": 1000 },
        "location": { "type": "string", "maxLength": 100 },
        "order": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "quote", "rating"]
    },
    "FaqItem": {
      "title": "FaqItem",
      "description": "Frequently asked question item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "question": { "type": "string", "maxLength": 250 },
        "answer": { "type": "string", "maxLength": 1500 },
        "order": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "question", "answer"]
    },
    "SiteProfile": {
      "title": "SiteProfile",
      "description": "Site brand, owner information, and contact links",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "brandName": { "type": "string", "maxLength": 100 },
        "studioType": { "type": "string", "maxLength": 150 },
        "title": { "type": "string", "maxLength": 150 },
        "headline": { "type": "string", "maxLength": 250 },
        "subheading": { "type": "string", "maxLength": 350 },
        "bio": { "type": "string", "maxLength": 2500 },
        "avatar": { "type": "string", "maxLength": 1000 },
        "email": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 50 },
        "whatsapp": { "type": "string", "maxLength": 50 },
        "location": { "type": "string", "maxLength": 100 },
        "availability": { "type": "string", "maxLength": 100 },
        "socialGithub": { "type": "string", "maxLength": 300 },
        "socialLinkedin": { "type": "string", "maxLength": 300 },
        "socialFacebook": { "type": "string", "maxLength": 300 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["brandName", "headline", "email"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Authorized site administrator record",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 150 },
        "role": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "email", "role"]
    }
  },
  "firestore": {
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Portfolio projects collection"
    },
    "/services/{serviceId}": {
      "schema": "Service",
      "description": "Service offerings collection"
    },
    "/pricingPlans/{planId}": {
      "schema": "PricingPlan",
      "description": "Pricing tiers collection"
    },
    "/testimonials/{testimonialId}": {
      "schema": "Testimonial",
      "description": "Client testimonials collection"
    },
    "/faqs/{faqId}": {
      "schema": "FaqItem",
      "description": "FAQ questions and answers collection"
    },
    "/settings/{settingId}": {
      "schema": "SiteProfile",
      "description": "Global website settings and profile configuration"
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Site administrators collection"
    }
  }
}
